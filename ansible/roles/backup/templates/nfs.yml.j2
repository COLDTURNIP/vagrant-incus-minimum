---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: {{ backup_name }}
  namespace: {{ backup_namespace }}
spec:
  replicas: 1
  strategy:
    type: Recreate
  selector:
    matchLabels:
      app: {{ backup_name }}
  template:
    metadata:
      labels:
        app: {{ backup_name }}
    spec:
      nodeSelector:
        kubernetes.io/hostname: {{ groups['servers'][0] }}
      tolerations:
        - key: node-role.kubernetes.io/control-plane
          operator: Exists
          effect: NoSchedule
      containers:
        - name: nfs
          image: {{ nfs_image }}
          env:
            - name: EXPORT_ID
              value: "14"
            - name: EXPORT_PATH
              value: /opt/backupstore
            - name: PSEUDO_PATH
              value: /opt/backupstore
            - name: NFS_DISK_IMAGE_SIZE_MB
              value: "4096"
          securityContext:
            privileged: true
          readinessProbe:
            tcpSocket:
              port: 2049
          volumeMounts:
            - name: data
              mountPath: /opt/backupstore
            - name: ganesha
              mountPath: /usr/local/var/lib/nfs/ganesha
      volumes:
        - name: data
          hostPath:
            path: /var/lib/rancher/incus-backupstore/nfs
            type: DirectoryOrCreate
        - name: ganesha
          emptyDir: {}
---
apiVersion: v1
kind: Service
metadata:
  name: {{ backup_name }}
  namespace: {{ backup_namespace }}
spec:
  clusterIP: None
  selector:
    app: {{ backup_name }}
  ports:
    - name: nfs
      port: 2049
      targetPort: 2049
