# Managed by Ansible.
node-name: {{ inventory_hostname | to_json }}
node-ip: {{ incus_node_ips | join(',') | to_json }}
flannel-iface: lhstorage0
token: {{ hostvars['localhost']['cluster_token'] | to_json }}
kubelet-arg:
  - node-status-update-frequency=5s
{% if incus_role == 'server' %}
bind-address: {{ ('::' if incus_network_stack in ['ipv6', 'dual6'] else '0.0.0.0') | to_json }}
advertise-address: {{ incus_node_ips[0] | to_json }}
cluster-cidr: {{ incus_pod_cidrs | join(',') | to_json }}
service-cidr: {{ incus_service_cidrs | join(',') | to_json }}
flannel-ipv6-masq: {{ (incus_network_stack != 'ipv4') | to_json }}
write-kubeconfig-mode: "0600"
tls-san: {{ incus_node_ips | to_json }}
disable:
  - traefik
  - servicelb
node-taint:
  - node-role.kubernetes.io/control-plane=true:NoSchedule
{% else %}
server: {{ incus_server_url | to_json }}
{% endif %}
