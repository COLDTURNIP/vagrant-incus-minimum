# Copy to terraform.tfvars (ignored). Review every network for host/VPN overlap.
project                = "lh-incus"
storage_pool           = "default"
# image, bootstrap_agent, network_stack and enable_storage_network come from
# cluster.yml; scripts/lab.py passes them with -var-file, overriding this file.
worker_count           = 3
enable_v2              = true
# shared_directory = "/absolute/path/on/incus/host"
